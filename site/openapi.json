{
 "openapi": "3.1.0",
 "info": {
  "title": "City education and early-childhood spending (prototype)",
  "version": "2026-11-17",
  "description": "Static JSON files for Naga, Zamboanga City and Cagayan de Oro: no key, no tracking, CORS open. Every row has a city field. Join schools on DepEd school ID and places on 10-digit PSGC codes. Every row names its source_id; see /api/sources.json.",
  "license": {
   "name": "ODC-BY-1.0",
   "url": "https://opendatacommons.org/licenses/by/1-0/"
  }
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [],
