  "title": "Naga education and early-childhood spending (prototype)",
  "version": "2026-11-17",
  "description": "Static JSON files: no key, no tracking, CORS open. Join schools on DepEd school ID and places on 10-digit PSGC codes. Every row names its source_id; see /api/sources.json.",
  "license": {
   "name": "ODC-BY-1.0",
   "url": "https://opendatacommons.org/licenses/by/1-0/"
  }
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [],
