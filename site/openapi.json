     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CheckList"
        },
        "example": {
         "checks": [
          {
           "check_id": "AB2026-total",
           "what": "Annual Budget 2026, enacted by Ord. No. 2025-131: rows on the public Browse page add up to the page's stated total",
           "expected": 1664699680.0,
           "actual": 1664699680.0,
           "unit": "PHP",
           "status": "match",
           "source_id": "naga-ab2026",
           "url": "https://budget.naga.gov.ph/annual/2026/browse"
          },
          {
           "check_id": "AB2026-split",
           "what": "Annual Budget 2026, enacted by Ord. No. 2025-131: PS + MOOE + FE + CO equals the row's total, for every row that gives a split (4 rows give only a total)",
           "expected": 426.0,
           "actual": 426.0,
           "unit": "rows",
           "status": "match",
           "source_id": "naga-ab2026",
           "url": "https://budget.naga.gov.ph/annual/2026/browse"
          }
         ]
        }
       }
      }
     }
    }
   }
