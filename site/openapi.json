  "/api/schools/{school_id}.json": {
   "get": {
    "operationId": "getSchool",
    "summary": "One school",
    "description": "One school by its DepEd school ID.",
    "parameters": [
     {
      "name": "school_id",
      "in": "path",
      "required": true,
      "description": "DepEd 6-digit school ID",
      "schema": {
       "type": "string",
       "pattern": "^\\d{6}$"
      },
      "example": "114497"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/School"
