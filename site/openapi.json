 "components": {
  "schemas": {
   "BudgetLine": {
    "type": "object",
    "description": "Naga City education, early-childhood, nutrition and child-welfare budget rows (AB 2026 enacted, AIP 2027), tagged by domain and fund",
    "properties": {
     "line_id": {
      "type": "string",
      "description": "The row's ID on budget.naga.gov.ph; its public page is source_url"
     },
     "cycle": {
      "type": "string"
     },
     "document": {
      "type": "string"
     },
     "fiscal_year": {
      "type": [
       "integer",
       "null"
      ]
     },
     "status": {
      "type": "string"
     },
     "aip_reference_code": {
      "type": "string",
      "description": "The City's AIP reference code, as printed"
     },
     "office_code": {
      "type": "string"
     },
     "office_name": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "pap_class": {
      "type": "string"
     },
     "domain": {
      "type": "string",
      "description": "Tag from this project's rules (pipeline/build.py RULES); tag_rule names the rule"
     },
     "tag_rule": {
      "type": "string"
     },
     "fund_sources": {
      "type": "string",
      "description": "Funds the City's portal lists for the row (e.g. SEF, GF); empty if the row's page wasn't read"
     },
     "thematic_tags": {
      "type": "string"
     },
     "ps": {
      "type": [
       "number",
       "null"
      ],
      "description": "Personal services, PHP"
     },
     "mooe": {
      "type": [
       "number",
       "null"
      ],
      "description": "Maintenance and other operating expenses, PHP"
     },
     "co": {
      "type": [
       "number",
       "null"
      ],
      "description": "Capital outlay (plus financial expenses), PHP"
     },
     "total": {
      "type": [
       "number",
       "null"
      ],
      "description": "Row total as published, PHP"
     },
     "finish_line": {
      "type": "string"
     },
     "place_level": {
      "type": "string",
      "description": "Finest place the source states: 'city' means no school or barangay is named"
     },
     "place_code": {
      "type": "string"
     },
     "school_ids": {
      "type": "string"
     },
     "barangay_codes": {
      "type": "string"
     },
     "source_id": {
      "type": "string"
     },
     "source_url": {
      "type": "string"
     },
     "retrieved": {
      "type": "string"
     },
     "validation": {
      "type": "string"
     }
    }
   },
   "School": {
    "type": "object",
    "description": "Every school in DepEd's Schools Division of Naga City, with enrollment, City-SEF-paid staff, LGU/SEF-funded ICT and facilities",
    "properties": {
     "school_id": {
      "type": "string",
      "description": "DepEd 6-digit school ID (string)"
     },
     "school_name": {
      "type": "string"
     },
     "sector": {
      "type": "string"
     },
     "management": {
      "type": "string"
     },
     "school_district": {
      "type": "string"
     },
     "barangay_deped": {
      "type": "string"
     },
     "psgc_barangay_code": {
      "type": "string",
      "description": "PSA 10-digit PSGC barangay code (string); empty if unmatched"
     },
     "psgc_barangay_name": {
      "type": "string"
     },
     "offers_es": {
      "type": "boolean"
     },
     "offers_jhs": {
      "type": "boolean"
     },
     "offers_shs": {
      "type": "boolean"
     },
     "learners_2025_26": {
      "type": [
       "integer",
       "null"
      ]
     },
     "kinder_2025_26": {
      "type": [
       "integer",
       "null"
      ]
     },
     "learners_2023_24": {
      "type": [
       "number",
       "null"
      ]
     },
     "learners_2017_18": {
      "type": [
       "number",
       "null"
      ]
     },
     "classrooms_instructional_2023_24": {
      "type": [
       "number",
       "null"
      ]
     },
     "buildings_major_repair_or_worse_2023_24": {
      "type": [
       "number",
       "null"
      ]
     },
     "makeshift_rooms_2023_24": {
      "type": [
       "number",
       "null"
      ]
     },
     "staff_city_sef_2023_24": {
      "type": [
       "number",
       "null"
      ],
      "description": "School staff (teachers and non-teaching) paid from the City SEF, per DepEd's personnel file"
     },
     "teachers_city_sef_2023_24": {
      "type": [
       "number",
       "null"
      ],
      "description": "Teachers paid from the City SEF, per DepEd's personnel file"
     },
     "staff_other_lgu_2023_24": {
      "type": [
       "number",
       "null"
      ],
      "description": "School staff paid from other LGU funds, per DepEd's personnel file"
     },
     "ict_items_lgu_sef_2023_24": {
      "type": [
       "number",
       "null"
      ],
      "description": "ICT equipment items DepEd lists as funded by the LGU or its SEF"
     },
     "crla_2025_26": {
      "type": "string",
      "description": "'published' if the school has a row in DepEd's machine-ready CRLA file, else 'not published'"
     },
     "source_ids": {
      "type": "string"
     },
     "learners_per_classroom_2023_24": {
      "type": [
       "number",
       "null"
      ]
     }
    }
   },
   "Barangay": {
