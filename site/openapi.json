  "/api/schools/{school_id}.json": {
   "get": {
    "operationId": "getSchool",
    "summary": "One school",
    "description": "One school by its DepEd school ID.",
    "parameters": [
     {
      "name": "school_id",
      "in": "path",
      "required": true,
      "description": "DepEd 6-digit school ID",
      "schema": {
       "type": "string",
       "pattern": "^\\d{6}$"
      },
      "example": "114497"
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/School"
        },
        "example": {
         "school_id": "114497",
         "school_name": "Calauag Elementary School",
         "sector": "Public",
         "management": "DepED Managed",
         "school_district": "Naga North District",
         "barangay_deped": "CALAUAG",
         "psgc_barangay_code": "0501724006",
         "psgc_barangay_name": "Calauag",
         "offers_es": true,
         "offers_jhs": false,
         "offers_shs": false,
         "learners_2025_26": 1062,
         "kinder_2025_26": 145,
         "learners_2023_24": 1145.0,
         "learners_2017_18": 1384.0,
         "classrooms_instructional_2023_24": 35.0,
         "buildings_major_repair_or_worse_2023_24": 0.0,
         "makeshift_rooms_2023_24": 0.0,
         "staff_city_sef_2023_24": 0.0,
         "teachers_city_sef_2023_24": 0.0,
