 "components": {
  "schemas": {
   "BudgetLine": {
    "type": "object",
    "description": "Education, early-childhood, nutrition and child-welfare budget rows for Naga (AB 2026, AIP 2027), Zamboanga City and Cagayan de Oro (AB 2026, machine-read), tagged by domain, fund and place",
    "properties": {
     "line_id": {
      "type": "string",
      "description": "Row ID. Naga: the row's ID on budget.naga.gov.ph. Ordinance books: city, year, page and sequence"
     },
     "city": {
      "type": "string",
      "description": "This project's city slug: naga, zamboanga or cdo"
     },
     "cycle": {
      "type": "string"
     },
     "document": {
      "type": "string"
     },
     "fiscal_year": {
      "type": [
       "integer",
       "null"
      ]
     },
     "status": {
      "type": "string"
     },
     "aip_reference_code": {
      "type": "string",
      "description": "Naga: the City's AIP reference code; ordinance books: the account code if printed"
     },
     "office_code": {
      "type": "string"
     },
     "office_name": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "pap_class": {
      "type": "string"
     },
     "domain": {
      "type": "string",
      "description": "Tag from this project's rules (pipeline/build.py RULES, SHEET_RULES, LINE_RULES); tag_rule names the rule"
     },
     "tag_rule": {
      "type": "string"
     },
     "fund_sources": {
      "type": "string",
      "description": "Naga: funds the portal lists (e.g. SEF, GF), empty if the row's page wasn't read. Ordinance books: the fund printed on the sheet"
     },
     "thematic_tags": {
      "type": "string"
     },
     "ps": {
      "type": [
       "number",
       "null"
      ],
      "description": "Personal services, PHP"
     },
     "mooe": {
      "type": [
       "number",
       "null"
      ],
      "description": "Maintenance and other operating expenses, PHP"
     },
     "co": {
      "type": [
       "number",
       "null"
      ],
      "description": "Capital outlay (plus financial expenses), PHP"
     },
     "total": {
      "type": [
       "number",
       "null"
      ],
      "description": "Row total as published (or as machine-read), PHP"
     },
     "finish_line": {
      "type": "string"
     },
     "place_level": {
      "type": "string",
      "description": "Finest place the source states: 'school' when the row names a school, 'city' when it names none"
     },
     "place_code": {
      "type": "string"
     },
     "school_ids": {
      "type": "string",
      "description": "DepEd school ID the row names, matched by school name (place_match says how)"
     },
     "place_match": {
      "type": "string"
     },
     "barangay_codes": {
      "type": "string"
     },
     "page": {
      "type": [
       "number",
       "null"
      ],
      "description": "Page of the ordinance PDF (ordinance books only)"
     },
     "source_id": {
      "type": "string"
     },
     "source_url": {
